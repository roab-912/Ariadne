# Développement local uniquement. Copier en .env avant le premier lancement.
POSTGRES_USER=ariadne
POSTGRES_PASSWORD=ariadne_local_only
POSTGRES_DB=ariadne
WEB_PORT=8080
API_PORT=8000
# Facultatif. RPC Ethereum mainnet HTTPS ; URL éventuellement porteuse d'un secret.
# Sans configuration : collecte explicitement indisponible, démo toujours consultable.
ETHEREUM_RPC_URL=
# Nécessaire uniquement à la découverte par adresse via Etherscan V2.
ETHERSCAN_API_KEY=
